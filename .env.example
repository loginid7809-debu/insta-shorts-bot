# ---------------------------------------------------------------------------
#  Local runs only. On GitHub Actions these come from repository secrets.
#  Never commit the real .env file.
# ---------------------------------------------------------------------------
SHEET_ID=1AbC...your-spreadsheet-id
GCP_SA_JSON='{"type":"service_account","project_id":"..."}'   # or use service_account.json
YT_CLIENT_ID=xxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=GOCSPX-xxxx
YT_REFRESH_TOKEN=1//0gxxxx

# optional
# IG_COOKIES_FILE=./cookies.txt
# HTTP_PROXY_URL=http://user:pass@host:port
# DAILY_UPLOAD_LIMIT=6
# UPLOADS_PER_RUN=1
# MIN_GAP_MINUTES=60
# TIMEZONE=Asia/Kolkata
